# ============================================================
# PRODUCCION — Qlik Automate Creator
# Copiar a .env y rellenar los valores seguros
# ============================================================

NODE_ENV=production
PORT=3000
# Origen único permitido para solicitudes mutables autenticadas por cookies.
FRONTEND_URL=https://tu-dominio.com

# PostgreSQL — usar el host externo si postgres no corre en compose
DATABASE_URL=postgres://qlik_app:CAMBIAR_PASSWORD@localhost:5432/qlik_automatizaciones
POSTGRES_USER=qlik_app
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_seguro

# OAuth Qlik — cliente web registrado en Qlik Cloud
QLIK_CLIENT_ID=
QLIK_CLIENT_SECRET=
# La URI de redirección debe coincidir con la registrada en Qlik Cloud
QLIK_REDIRECT_URI=https://tu-dominio.com/api/auth/qlik/callback
QLIK_OAUTH_SCOPES=user_default offline_access identity.name:read identity.email:read identity.subject:read identity.picture:read automations automations.private automations.shared spaces:read apps:read data-integration
# Tiempo máximo por llamada al tenant Qlik durante OAuth, en milisegundos.
QLIK_OAUTH_TIMEOUT_MS=10000

# Cifrado AES-256-GCM — GENERAR CON: openssl rand -base64 32
CIFRADO_CLAVE_PRINCIPAL=CAMBIAR_32_bytes_base64

# API remota (opcional — para métricas o logging externo)
REMOTE_API_URL=
REMOTE_API_KEY=

# Bootstrap inicial — solo para el primer inicio
BOOTSTRAP_ORGANIZACION_NOMBRE=Mi Empresa
BOOTSTRAP_TENANT_NOMBRE=Tenant Principal
BOOTSTRAP_TENANT_HOST=mi-tenant.eu.qlikcloud.com
BOOTSTRAP_TENANT_ID_QLIK=
# Correo del superadministrador (primer usuario que haga login)
SUPERADMINMAIL=admin@mi-empresa.com
BOOTSTRAP_SUPERADMIN_NOMBRE=Administrador

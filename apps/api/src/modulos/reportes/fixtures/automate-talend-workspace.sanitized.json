{
  "blocks": [
    {
      "name": "executeTask",
      "type": "EndpointBlock",
      "inputs": [
        { "id": "task", "value": "TASK_ID_SANITIZED" },
        {
          "id": "context",
          "mode": "keyValue",
          "value": [
            { "key": "credenciales", "value": "{ $.Credenciales }" },
            { "key": "bq_number_csv", "value": "{ $.BqNumberCsv }" },
            { "key": "bq_export_data", "value": "{ $.BqExportData }" }
          ]
        }
      ]
    },
    {
      "name": "Credenciales",
      "type": "VariableBlock",
      "operations": [
        { "id": "set_value", "value": "/etc/credentials/gsc.json" }
      ]
    },
    {
      "name": "BqNumberCsv",
      "type": "VariableBlock",
      "operations": [{ "id": "set_value", "value": "NUMBER_ANTERIOR" }]
    },
    {
      "name": "BqExportData",
      "type": "VariableBlock",
      "operations": [{ "id": "set_value", "value": "EXPORT_ANTERIOR" }]
    }
  ]
}

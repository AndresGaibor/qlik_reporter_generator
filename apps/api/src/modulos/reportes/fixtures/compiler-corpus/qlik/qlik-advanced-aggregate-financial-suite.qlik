LIB CONNECT TO [Google BigQuery:Prod];
[Salida]: LOAD categoria,
  RangeCorrel(a,b,c,d) AS correlacion,
  RangeFractile(0.24,a,b,c,d) AS fractil,
  RangeKurtosis(a,b,c,d) AS curtosis,
  RangeSkew(a,b,c,d) AS sesgo,
  RangeStdev(a,b,c,d) AS desviacion,
  RangeMaxString(valor, etiqueta) AS max_texto,
  RangeMinString(valor, etiqueta) AS min_texto,
  RangeOnly(a,b,c) AS unico_rango,
  RangeMode(a,b,c,d) AS modo_rango,
  RangeNPV(0.1,a,b,c) AS npv_rango,
  RangeIRR(a,b,c,d) AS irr_rango,
  RangeXNPV(0.1,a,fecha,b,fecha2) AS xnpv_rango,
  RangeXIRR(a,fecha,b,fecha2) AS xirr_rango,
  Mode(valor) AS modo,
  Only(valor) AS unico,
  MaxString(valor) AS maximo_texto,
  MinString(valor) AS minimo_texto,
  FirstValue(valor) AS primero,
  LastValue(valor) AS ultimo,
  FirstSortedValue(valor,peso,2) AS segundo_ordenado,
  Concat(DISTINCT valor, '|', peso) AS concatenado,
  IRR(flujo) AS irr,
  NPV(0.1, flujo) AS npv,
  XIRR(flujo, fecha) AS xirr,
  XNPV(0.1, flujo, fecha) AS xnpv,
  BlackAndSchole(110,0.2,100,0.25,0.05,'call') AS black_schole,
  FV(0.05,10,-100,0,0) AS valor_futuro,
  nPer(0.05,-100,1000,0) AS periodos,
  Pmt(0.05,10,1000,0,0) AS pago,
  PV(0.05,10,-100,0,0) AS valor_presente,
  Rate(10,-100,1000,0,0) AS tasa
GROUP BY categoria;
SQL SELECT categoria, a, b, c, d, valor, etiqueta, peso, flujo, fecha, fecha2 FROM `p.d.agregados_financieros` ORDER BY id;

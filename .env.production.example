# QLIK REPORTES CREATOR — PRODUCCIÓN
# Copia a .env, reemplaza todos los placeholders y ejecuta: chmod 600 .env

# Identidad opcional del proyecto Compose.
COMPOSE_PROJECT_NAME=qlik_reportes_creator

# Red pública. Para Cloudflare Tunnel usa 127.0.0.1.
HOST_IP=127.0.0.1
PORT_WEB=4524

# Puerto INTERNO del API. Mantener 4523: nginx y healthchecks usan ese valor.
PORT_API=4523

# URL HTTPS pública, sin slash final. Obligatoria en producción.
FRONTEND_URL=https://tu-dominio.com

# PostgreSQL. Para el password usa, por ejemplo: openssl rand -hex 32
POSTGRES_USER=qlik_app
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# AES-256-GCM: exactamente 32 bytes en base64.
# Generar una sola vez con: openssl rand -base64 32
# NO rotar en una instalación existente sin migrar los secretos cifrados.
CIFRADO_CLAVE_PRINCIPAL=REEMPLAZAR_CON_CLAVE_BASE64_32_BYTES

# Normalmente no definas QLIK_REDIRECT_URI: producción deriva
# ${FRONTEND_URL}/api/auth/qlik/callback automáticamente.
# QLIK_REDIRECT_URI=https://tu-dominio.com/api/auth/qlik/callback

# OAuth se configura por tenant desde el wizard/admin.
# Solo usa estos overrides si existe una necesidad explícita.
# QLIK_OAUTH_TIMEOUT_MS=10000
# QLIK_OAUTH_SCOPES=

# URLs firmadas de GCS, en minutos.
GOOGLE_SIGNED_URL_MINUTOS=15

# Opcional para bootstrap administrado; el wizard también crea el superadmin.
# SUPERADMINMAIL=admin@tu-dominio.com

# =============================================================================
# QLIK AUTOMATE CREATOR — CONFIGURACIÓN DE PRODUCCIÓN
# =============================================================================
# Copia este archivo a .env en el servidor y ajusta los valores.
# NUNCA hagas commit de .env con secretos reales.

# =============================================================================
# RED Y PUERTOS
# =============================================================================
# IP del host para bind (127.0.0.1 = solo local, 0.0.0.0 = todas)
HOST_IP=127.0.0.1

PORT_WEB=4524
PORT_API=4523

# URL pública del frontend (sin trailing slash)
FRONTEND_URL=https://tu-dominio.com

# =============================================================================
# BASE DE DATOS (PostgreSQL)
# =============================================================================
# Credenciales de PostgreSQL - USAR VALORES SEGUROS
POSTGRES_USER=qlik_app
POSTGRES_PASSWORD=TU_PASSWORD_SEGURO_AQUI

DATABASE_URL=postgres://qlik_app:TU_PASSWORD_SEGURO@postgres:5432/qlik_automatizaciones

# =============================================================================
# QLIK OAUTH
# =============================================================================
# Timeout para OAuth en milisegundos
QLIK_OAUTH_TIMEOUT_MS=10000

# Scopes OAuth separados por espacios
QLIK_OAUTH_SCOPES=audit admin

# Redirect URI (normalmente no necesita cambiar si FRONTEND_URL está configurado)
# QLIK_REDIRECT_URI=https://tu-dominio.com/api/auth/qlik/callback

# =============================================================================
# CIFRADO
# =============================================================================
# Clave AES-256-GCM para cifrado de secretos en BD
# Generar con: openssl rand -base64 32
CIFRADO_CLAVE_PRINCIPAL=TU_CLAVE_CIFRADO_32_BYTES_SEGURA

# =============================================================================
# GOOGLE CLOUD
# =============================================================================
# Duración de URLs firmadas en minutos (1-60)
GOOGLE_SIGNED_URL_MINUTOS=15

# =============================================================================
# APLICACIÓN
# =============================================================================
NODE_ENV=production

# Superadmin inicial (opcional, para bootstrap)
# SUPERADMINMAIL=admin@tu-dominio.com

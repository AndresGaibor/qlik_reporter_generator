# =============================================================================
# QLIK AUTOMATE CREATOR — CONFIGURACIÓN
# =============================================================================
# Copia este archivo a .env y ajusta los valores.
# Con los valores por defecto, la aplicación funciona sin cambios.
#
# PUERTO WEB (frontend Nginx)
PORT_WEB=4524

# PUERTO API (backend Bun)
PORT_API=4523

# IP del host para bind (127.0.0.1 = solo local, 0.0.0.0 = todas las interfaces)
HOST_IP=127.0.0.1

# Origen único permitido para solicitudes mutables autenticadas por cookies.
FRONTEND_URL=http://localhost:4525

# =============================================================================
# BASE DE DATOS
# =============================================================================
# Para Bun en el host, PostgreSQL se expone en localhost.
DATABASE_URL=postgres://qlik_app:cambiar_en_produccion@localhost:5432/qlik_automatizaciones

# Tiempo máximo por llamada al tenant Qlik durante OAuth, en milisegundos.
QLIK_OAUTH_TIMEOUT_MS=10000

# Fallback OAuth opcional; normalmente se configura por tenant desde la app.
QLIK_CLIENT_ID=
QLIK_CLIENT_SECRET=
# Clave AES-256-GCM; generar con: openssl rand -base64 32
CIFRADO_CLAVE_PRINCIPAL=

# =============================================================================
# POSTGRES (Docker Compose)
# =============================================================================
# Solo necesarios si quieres credenciales personalizadas para PostgreSQL.
# POSTGRES_USER=qlik_app
# POSTGRES_PASSWORD=cambiar_en_produccion

# =============================================================================
# GOOGLE CLOUD STORAGE
# =============================================================================
# Duración de las URLs firmadas para acceder a archivos en GCS (1-60 minutos)
GOOGLE_SIGNED_URL_MINUTOS=15
